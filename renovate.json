{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["beta-testing"],
  "enabledManagers": ["gradle", "gradle-wrapper", "github-actions"],
  "commitMessageSuffix": "[skip release]",
  "prConcurrentLimit": 5,
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Haze artifacts share one version.",
      "matchPackageNames": ["dev.chrisbanes.haze:**"],
      "groupName": "Haze"
    },
    {
      "description": "KSP and the Kotlin compiler plugins must move together.",
      "matchPackageNames": ["org.jetbrains.kotlin.plugin.**", "com.google.devtools.ksp**"],
      "groupName": "Kotlin and KSP"
    },
    {
      "description": "Both AGP plugin ids share one version.",
      "matchPackageNames": ["com.android.application**", "com.android.test**", "com.android.tools.build:gradle"],
      "matchManagers": ["gradle"],
      "groupName": "Android Gradle Plugin"
    },
    {
      "matchPackageNames": ["androidx.room:**"],
      "groupName": "Room"
    },
    {
      "description": "Major updates wait for a person to look.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
